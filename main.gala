import "core/core.gala";
import "core/net.gala";
import "core/cfunctions.gala";
import "core/threads.gala";
import "core/mem.gala";
import "./common.gala";

struct Client {
    active: bool,
    id: int,
    socket: TcpSocket,
    entity_id: int,
}
struct State {
    state_mutex:    Mutex,
    clients:        [1024]Client,
    ccount:         int,
    entities:       [1024]Entity,
}

struct hc_payload { clients_socket: TcpSocket, s: ^State }
fn handle_client(payload: ^hc_payload) {
    client_socket := payload^.clients_socket;
    s := payload^.s;

    println("fd:", client_socket.fd);

    tcp_send(client_socket, transmute([]byte)("Hello, Client!"));

    free(cast(rawptr)payload);
    println("closed fd:", client_socket.fd);
}

fn insert_client(s: ^State, c: Client, e: Entity): struct { r: bool, id: int}  {
    if s^.ccount >= len(s^.clients) {
        return {false, 0};
    }
    i := 0;
    for v in s^.clients {
        if v.active { i += 1; continue; }
        nc := c;
        nc.entity_id = i; // entity id. not really needed cus should be the same. or nah not really. yeah
        s^.clients[i] = nc;
        s^.entities[i] = e;
        return {true, i};
    }
    return {false, 0};
}

fn remove_client(s: ^State, c: Client): struct { r: bool, id: int} {
    i := 0; for v in s^.clients {
        if v.id == c.id {
            s^.clients[i].active = false;
            return {true, i};
        }
        i += 1;
    }
    return {false, 0};
}
fn kill_client(c: Client) {
    tcp_shutdown(c.socket, SHUT_RDWR);
    tcp_close(c.socket);
}

fn main() {
    listener := tcp_listen(1234, 10);
    s := new::<State>();

    on := true;
    while on  {
        println("Accepting connection.");
        c := tcp_accept(listener);
        if c.fd < 0 {
            println("Error in receiving.");
            println("Ignoring.");
            continue;
        }
        payload := new::<hc_payload>();
        payload^.clients_socket = c;
        payload^.s = s;
        thread_spawn(handle_client, payload);
    }
    
    free(cast(rawptr)s);
    println("Closing listener.");
    tcp_close(listener);
}
