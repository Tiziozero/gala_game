import "core/core.gala";
import "core/rl.gala";
import "core/net.gala";
import "core/cfunctions.gala";
import "core/threads.gala";
import "core/mem.gala";
import "core/buffer_io.gala";
import "./common.gala";

struct Client {
    active: bool,
    id: int,
    socket: TcpSocket,
    entity_id: int,
    move_to: Vector2,
}
struct State {
    state_mutex:    Mutex,
    clients:        [MAX_ENTITIES]Client,
    ccount:         int,
    entities:       [MAX_ENTITIES]Entity,
    edata:          [MAX_ENTITIES]struct { lock: Mutex },
    on:             bool,
}

global_i := 0;
struct hc_payload { clients_socket: TcpSocket, s: ^State }
fn handle_client(payload: ^hc_payload) {
    client_socket := payload^.clients_socket;
    s := payload^.s;

    println("fd:", client_socket.fd);


    c := Client{true, -1, client_socket, -1, {0,0}};
    e := Entity{true, -1, {0,0}, {0,0}, 0};
    nc := insert_client(s, c, e);

    if !nc.r {
        println("Failed to insert client?");
        return;
    }
    
    // send entity id
    b := buffer_make(64);
    buffer_write(&b, s^.clients[nc.id].entity_id);
    // no pipe
    tcp_send(client_socket, buffer_slice(&b), flags=0x4000);
    buffer_destroy(&b);

    c = s^.clients[nc.id];
    rb := [1024]byte{};
    frame_arena := arena_make(1024*16);
    while true {
        n := tcp_recv(c.socket, rb[:]);
        if n <= 0 {
            println("revceived {} bytes from client. killing.", n);
            break;
        }
        bf := buffer_wrap(rb[:n]);
        m := Message{0, { nufin = 0 }};
        if !unpack_message(&bf,&m, arena_allocator(&frame_arena)) {
            v := 0;
            for i in rb[:n] {
                println(v, i);
            }
            println("failed to unpack message");
            break;
        }
        if m.kind == MK_UPDATE {
            uk := m.data.update.kind;
            if uk == UPDATE_MOVE_TO {
                p := m.data.update.data.move_to;
                mutex_lock(&s^.state_mutex);
                // s^.entities[c.entity_id].pos = m.data.update.pos;
                // s^.entities[c.entity_id].dir = m.data.update.dir;
                // s^.entities[c.entity_id].d = m.data.update.d;
                s^.clients[c.id].move_to = p;
                mutex_unlock(&s^.state_mutex);
            } else {
                println("Invalid update message kind form user: {} (got {}).", c.id, uk);
                break;
            }
        }
    }
    remove_client(s, c.id);
    arena_destroy(&frame_arena);
    free(cast(rawptr)payload);
}

fn find_client(s: ^State, id: int): struct { r: bool, id: int } {
    i := 0;
    for c in s^.clients {
        if c.active && c.id == id {
            return {true, i};
        }
        i += 1;
    }
    return {false, -1};
}
fn insert_entity(s: ^State, e: Entity): struct { r: bool, id: int } {
    i := 0;
    for v in s^.entities {
        if v.active {
            i += 1;
            continue;
        }

        ne := e;
        ne.id = i;
        ne.active = true;
        s^.entities[i] = ne;
        mutex_init(&s^.edata[i].lock);

        return {true, i};
    }

    return {false, -1};
}

fn delete_entity(s: ^State, id: int): bool {
    if id < 0 || id >= len(s^.entities) {
        return false;
    }

    if !s^.entities[id].active {
        return false;
    }

    s^.entities[id].active = false;
    mutex_destroy(&s^.edata[id].lock);
    return true;
}

fn insert_client(s: ^State, c: Client, e: Entity): struct { r: bool, id: int } {
    if s^.ccount >= len(s^.clients) {
        return {false, -1};
    }

    // Find an available client slot first.
    i := 0;
    for v in s^.clients {
        if v.active {
            i += 1;
            continue;
        }

        // Allocate the entity independently of the client slot.
        er := insert_entity(s, e);
        if !er.r {
            return {false, -1};
        }

        nc := c;
        nc.id = i;
        nc.entity_id = er.id;
        nc.active = true;

        s^.clients[i] = nc;
        s^.ccount += 1;

        return {true, i};
    }

    return {false, -1};
}

fn remove_client(s: ^State, id: int): bool {
    if id < 0 || id >= len(s^.clients) {
        return false;
    }

    if !s^.clients[id].active {
        return false;
    }

    entity_id := s^.clients[id].entity_id;

    s^.clients[id].active = false;
    s^.ccount -= 1;

    delete_entity(s, entity_id);
    return true;
}
fn kill_client(s: ^State, c: Client) {
    remove_client(s, c.id);
    tcp_shutdown(c.socket, SHUT_RDWR);
    tcp_close(c.socket);
    println("closed client:", c.id, c.socket.fd);
}


fn update_state(s: ^State, dt: f32 = 0.01 /* for now ig */) {
    for c in s^.clients {
        if !c.active  { continue; }
        mutex_lock(&s^.edata[c.entity_id].lock);
            e := s^.entities[c.entity_id];
            dv := Vector2{
                c.move_to.x - e.pos.x,
                c.move_to.y - e.pos.y,
            };
            if Vector2Length(dv) > 0.01 {
                d := Vector2Normalize(dv);
                d.x *= dt*1.2;
                d.y *= dt*1.2;
                e.pos = Vector2Add(e.pos, d);
                nd := -atan2f(dv.x, dv.y) / (PI / 2);

                if nd < 0 {
                    nd += 4;
                }
                e.d = nd;
            }
                    
            s^.entities[c.entity_id] = e;
        mutex_unlock(&s^.edata[c.entity_id].lock);
    }
}
fn sender_thread(s: ^State) {
    entities := [1024]Entity{};
    b := buffer_make(1024);
    while s^.on {
        sleep_ms(10);
        update_state(s);
        if s^.ccount <= 0 {
            continue; // no clients to send to
        }
        mutex_lock(&s^.state_mutex);
        l := 0;
        i := 0;
        for e in s^.entities {
            if e.active {
                mutex_lock(&s^.edata[i].lock);
                entities[l] = e;
                mutex_unlock(&s^.edata[i].lock);
                l += 1;
            }
            i += 1;
        }
        println("{} entities", l);
        mutex_unlock(&s^.state_mutex);
        msg := Message { MK_STATE, { state = { entities[:l] } } };
        if !pack_message(msg, &b) {
            println("failed to pack message");
            buffer_clear(&b);
            return;
        }
        for c in s^.clients {
            if !c.active { continue; }
            n := tcp_send(c.socket, buffer_slice(&b), flags=0x4000);
            if n != b.length {
                kill_client(s, c);
                println("failed to send all bytes to", c.id);
                continue;
            }
        }
        buffer_clear(&b);
    }
}

fn main(): i32 {
    listener := tcp_listen(1234, 10);
    if listener.fd < 0 {
        println("Failed to initialise listener.");
        return -1;
    }
    s := new::<State>();

    st := thread_spawn(sender_thread, s);

    s^.on = true;

    insert_entity(s, {true, -1, {20, 20}, {0, 0}, PI/2*3});
    insert_entity(s, {true, -1, {40, 20}, {0, 0}, PI/2*3});
    insert_entity(s, {true, -1, {4, 4}, {0, 0}, PI/2*3});
    insert_entity(s, {true, -1, {0.5, 0.5}, {0, 0}, PI/2*3});
    while s^.on  {
        println("Accepting connection.");
        c := tcp_accept(listener);
        if c.fd < 0 {
            println("Error in receiving.");
            println("Ignoring.");
            continue;
        }
        payload := new::<hc_payload>();
        payload^.clients_socket = c;
        payload^.s = s;
        thread_spawn(handle_client, payload);
    }
    thread_join(st);
    
    free(cast(rawptr)s);
    println("Closing listener.");
    tcp_close(listener);
    return 0;
}
